{
  "manifest_version": 3,
  "name": "Mango Story Downloader",
  "description": "Tải video story Facebook về máy thành file mp4",
  "version": "0.4.2",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Mango Story Downloader",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/*"],
      "js": ["src/msd_story.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.facebook.com/*"],
      "js": ["src/msd_mp4.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["downloads", "scripting"],
  "host_permissions": ["https://*.facebook.com/*"]
}
